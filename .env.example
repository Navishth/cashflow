# Copy to .env for Docker Compose. Generate fresh random values; never commit .env.
DATABASE_USER=cashflow
DATABASE_PASSWORD=replace-with-a-long-random-password
ML_API_KEY=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
APP_PRODUCTION=false
MAIL_MODE=file
MAIL_FROM=hello@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_TLS=false
SMTP_HEALTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave empty to use FRONTEND_URL + /login/oauth2/code/google.
GOOGLE_REDIRECT_URI=
API_DOCS_ENABLED=true
# Frontend only. Empty uses same-origin proxy. Never put secrets in VITE_*.
VITE_API_URL=
